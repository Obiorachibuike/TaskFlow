# ─────────────────────────── TaskFlow environment ───────────────────────────
# Copy to .env and fill in values. NEVER commit real secrets.

# ── Core ────────────────────────────────────────────────────────────────────
# Public URL the app is served from (used in emails and OAuth redirects).
APP_URL=http://localhost:3000
# Comma-separated extra origins allowed to call the app (deployment previews).
ALLOWED_ORIGINS=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Standard Postgres connection string. For a fully local stack run:
#   npm run db:embedded     (bootstraps an embedded Postgres in .data/postgres)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
# Optional read replica / pooler URL (defaults to DATABASE_URL).
DIRECT_DATABASE_URL=

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs (generate: openssl rand -base64 32).
AUTH_SECRET=
# Trust host header behind proxies (set to "1" when deployed behind a proxy).
AUTH_TRUST_HOST=1

# ── Google OAuth (optional) ─────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials — redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email delivery (Resend) ─────────────────────────────────────────────────
# When RESEND_API_KEY is empty, emails are logged to the console (dev transport).
RESEND_API_KEY=
EMAIL_FROM="TaskFlow <onboarding@resend.dev>"

# ── AI provider ─────────────────────────────────────────────────────────────
# "openai" (OpenAI-compatible chat completions) or "anthropic".
AI_PROVIDER=openai
# OpenAI-compatible endpoint + key (also works with Azure/OpenRouter/etc. via AI_BASE_URL).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Anthropic alternative:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Hard limits per request.
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_MS=30000
AI_REQUESTS_PER_USER_PER_HOUR=30

# ── Redis / background jobs ─────────────────────────────────────────────────
# Optional. Without REDIS_URL a durable in-process job runner is used (single-node only).
REDIS_URL=
BULLMQ_QUEUE_PREFIX=taskflow

# ── File storage ────────────────────────────────────────────────────────────
# "local" (default, .data/uploads) or "s3" (any S3-compatible provider).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Max attachment size in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# ── GitHub integration ──────────────────────────────────────────────────────
# OAuth app credentials (optional; without them only manual/webhook flows work).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Webhook secret used to verify X-Hub-Signature-256 (required for webhooks).
GITHUB_WEBHOOK_SECRET=
# 32-byte hex key used to encrypt stored integration tokens (openssl rand -hex 32).
INTEGRATION_ENCRYPTION_KEY=

# ── Real-time ───────────────────────────────────────────────────────────────
# Socket.IO path served by the custom server (server.ts). See README for
# multi-node deployments (Redis adapter required).
SOCKET_PATH=/socket.io

# ── Jobs / scheduling ───────────────────────────────────────────────────────
# Interval for due-date reminders etc. (ms). 0 disables the scheduler.
JOB_SCHEDULER_INTERVAL_MS=60000
